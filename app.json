{
  "expo": {
    "name": "Muntej",
    "slug": "nizamy-muntej",
    "scheme": "muntej",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6FB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.muntej.app"
    },
    "android": {
      "package": "sa.muntej.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ar"
            ],
            "android": [
              "en",
              "ar"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Muntej uses the microphone so you can say a task out loud."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Muntej uses your photos so you can attach proof of finished work.",
          "cameraPermission": "Muntej uses the camera so you can photograph proof of finished work."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6D4AFF",
          "defaultChannel": "muntej"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "nizamys-team",
    "extra": {
      "eas": {
        "projectId": "aef47fd8-c58b-4547-9e0b-96105ee8d6fa"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aef47fd8-c58b-4547-9e0b-96105ee8d6fa",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
